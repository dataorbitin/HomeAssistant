# Optional migration connection; defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=
# Reserved metadata; SQLAlchemy uses DATABASE_URL, not Supabase REST.
SUPABASE_URL=
SUPABASE_KEY=
EVOLUTION_API_BASE_URL=https://YOUR-EVOLUTION-SERVICE.up.railway.app
EVOLUTION_API_INSTANCE=home-assistance
EVOLUTION_API_KEY=
WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
APP_ENV=development
ADMIN_API_KEY=
DEFAULT_SOCIETY_NAME=Megapolis
MAX_CONTEXT_MESSAGES=8
MAX_CONTEXT_CHARACTERS=6000
LLM_TIMEOUT_SECONDS=20
EVOLUTION_TIMEOUT_SECONDS=15
EVOLUTION_MAX_ATTEMPTS=3
OUTBOX_POLL_SECONDS=3
OUTBOX_ENABLED=true
STORE_RAW_PAYLOADS=false
